{
  "name": "systemoneweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "System One in the browser: a vertical micro-model trained by an algorithmic System Two",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "train:snake": "tsx scripts/train.ts --game snake",
    "eval:snake": "tsx scripts/eval.ts --game snake",
    "bench:teacher": "tsx scripts/bench-teacher.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo:data": "tsx scripts/copy-demo-data.ts",
    "bench:lander": "tsx scripts/bench-lander.ts",
    "train:lander": "tsx scripts/train.ts --game lander",
    "eval:lander": "tsx scripts/eval.ts --game lander",
    "train": "tsx scripts/train.ts",
    "eval": "tsx scripts/eval.ts",
    "study": "tsx scripts/study.ts",
    "exp": "tsx experiments/run.ts",
    "site:build": "tsx scripts/build-site.ts",
    "site:deploy": "pnpm site:build && wrangler deploy",
    "hw:data": "tsx scripts/handwriting-data.ts",
    "hw:study": "tsx scripts/handwriting-study.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
